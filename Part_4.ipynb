   "source": [
    "# =============================================================================\n",
    "# ADVANCED SOCIAL MEDIA METADATA ENGINE\n",
    "# OPENROUTER FREE MODELS | GROQ FALLBACK | 4X CANDIDATES | RANKING\n",
    "# LOCAL CSV REPORTS + LOCAL THUMBNAILS | NO CLOUD STORAGE\n",
    "# =============================================================================\n",
    "\n",
    "# GitHub Actions-compatible runtime (no Google Colab runtime required)\n",
    "import os\n",
    "import re\n",
    "import sys\n",
    "import json\n",
    "import time\n",
    "import csv\n",
    "import subprocess\n",
    "import requests\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timedelta\n",
    "from zoneinfo import ZoneInfo\n",
    "\n",
    "from groq import Groq\n",
    "\n",
    "# =============================================================================\n",
    "# 1. CONFIGURATION\n",
    "# =============================================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import os\n",
    "\n",
    "# Automatically detect GitHub workspace\n",
    "WORKSPACE_ROOT = Path(\n",
    "    os.getenv(\"GITHUB_WORKSPACE\", Path.cwd())\n",
    ").resolve()\n",
    "\n",
    "# Input folder from Part 3\n",
    "SOURCE_FOLDER_PATH = (\n",
    "    WORKSPACE_ROOT / os.getenv(\"PART3_OUTPUT_DIR\", \"Ready_!\")\n",
    ").resolve()\n",
    "\n",
    "# Part 4 main output folder\n",
    "LOCAL_OUTPUT_DIR = (\n",
    "    WORKSPACE_ROOT / os.getenv(\"PART4_OUTPUT_DIR\", \"Part_4_Output\")\n",
    ").resolve()\n",
    "\n",
    "# Thumbnail folder\n",
    "THUMBNAIL_FOLDER_NAME = \"thum\"\n",
    "LOCAL_THUMBNAIL_DIR = LOCAL_OUTPUT_DIR / THUMBNAIL_FOLDER_NAME\n",
    "\n",
    "# Automatically create all required folders\n",
    "for folder in [\n",
    "    SOURCE_FOLDER_PATH,\n",
    "    LOCAL_OUTPUT_DIR,\n",
    "    LOCAL_THUMBNAIL_DIR\n",
    "]:\n",
    "    folder.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(\"✅ Automatic folder setup completed\")\n",
    "print(f\"📥 Part 3 Input: {SOURCE_FOLDER_PATH}\")\n",
    "print(f\"📤 Part 4 Output: {LOCAL_OUTPUT_DIR}\")\n",
    "print(f\"🖼️ Thumbnail Output: {LOCAL_THUMBNAIL_DIR}\")\n"
    "\n",
    "POSTING_SCHEDULE = [\n",
    "    \"10:00 AM\",\n",
    "    \"02:00 PM\",\n",
    "    \"06:00 PM\",\n",
    "    \"10:00 PM\"\n",
    "]\n",
    "\n",
    "OPENROUTER_URL = \"https://openrouter.ai/api/v1/chat/completions\"\n",
    "\n",
    "# Active and valid free models on OpenRouter\n",
    "OPENROUTER_MODELS = [\n",
    "    \"google/gemma-2-9b-it:free\",\n",
    "    \"meta-llama/llama-3-8b-instruct:free\",\n",
    "    \"mistralai/mistral-7b-instruct:free\",\n",
    "    \"qwen/qwen-2.5-72b-instruct:free\",\n",
    "    \"meta-llama/llama-3.2-3b-instruct:free\",\n",
    "    \"openrouter/free\"\n",
    "]\n",
    "\n",
    "# Active free or standard models on Groq\n",
    "GROQ_MODELS = [\n",
    "    \"llama-3.3-70b-versatile\",\n",
    "    \"llama3-8b-8192\",\n",
    "    \"gemma2-9b-it\",\n",
    "    \"mixtral-8x7b-32768\"\n",
    "]\n",
    "\n",
    "SHEET_HEADER = [\n",
    "    \"Video Name\",\n",
    "    \"Video Path\",\n",
    "    \"Status\",\n",
    "    \"Time_zone\",\n",
    "    \"Video Link\",\n",
    "    \"Thumbnail Link\",\n",
    "    \"YT Title\",\n",
    "    \"YT Description\",\n",
    "    \"YT Tags\",\n",
    "    \"TikTok Caption\",\n",
    "    \"Instagram Caption\",\n",
    "    \"FB Caption\",\n",
    "    \"Popular Captions\",\n",
    "    \"Hashtags (#)\",\n",
    "    \"Trending Event\",\n",
    "    \"Keywords\",\n",
    "    \"Snap Chat\",\n",
    "    \"AI Engine\",\n",
    "    \"Ranking Used\",\n",
    "    \"Winning Score\",\n",
    "    \"Candidate Scores\",\n",
    "    \"Generated At\"\n",
    "]\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 2. API KEYS\n",
    "# =============================================================================\n",
    "\n",
    "# API keys are supplied only through GitHub Actions Secrets.\n",
    "OPENROUTER_API_KEY = os.getenv(\"OPENROUTER_API_KEY\", \"\").strip()\n",
    "GROQ_API_KEY = os.getenv(\"GROQ_API_KEY\", \"\").strip()\n",
    "\n",
    "if not OPENROUTER_API_KEY and not GROQ_API_KEY:\n",
    "    raise RuntimeError(\n",
    "        \"Missing API keys. Add OPENROUTER_API_KEY and/or GROQ_API_KEY \"\n",
    "        \"to GitHub Settings > Secrets and variables > Actions.\"\n",
    "    )\n",
    "\n",
    "try:\n",
    "    groq_client = Groq(api_key=GROQ_API_KEY) if GROQ_API_KEY else None\n",
    "except Exception as e:\n",
    "    print(f\"Warning initializing Groq client: {e}\")\n",
    "    groq_client = None\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 3. LOCAL-ONLY REPORTING HELPERS\n",
    "# =============================================================================\n",
    "\n",
    "def get_last_post_time():\n",
    "    \"\"\"Read the last scheduled time from this run's local CSV if available.\"\"\"\n",
    "    csv_path = LOCAL_OUTPUT_DIR / \"metadata_rows.csv\"\n",
    "    if not csv_path.exists():\n",
    "        return None\n",
    "    try:\n",
    "        with csv_path.open(\"r\", newline=\"\", encoding=\"utf-8-sig\") as handle:\n",
    "            rows = list(csv.DictReader(handle))\n",
    "        for row in reversed(rows):\n",
    "            try:\n",
    "                return datetime.strptime(\n",
    "                    row.get(\"Time_zone\", \"\"), \"%Y-%m-%d %I:%M %p\"\n",
    "                ).replace(tzinfo=SCHEDULE_TIMEZONE)\n",
    "            except (ValueError, TypeError):\n",
    "                continue\n",
    "    except Exception as exc:\n",
    "        print(\"Local schedule read warning:\", exc)\n",
    "    return None\n",
    "\n",
    "\n",
    "def get_next_schedule_slot(last_dt):\n",
    "    schedule_times = sorted(\n",
    "        datetime.strptime(t, \"%I:%M %p\").time()\n",
    "        for t in POSTING_SCHEDULE\n",
    "    )\n",
    "\n",
    "    now = datetime.now(SCHEDULE_TIMEZONE)\n",
    "\n",
    "    if last_dt is None:\n",
    "        last_dt = now - timedelta(minutes=1)\n",
    "\n",
    "    base_date = max(last_dt.date(), now.date())\n",
    "\n",
    "    for schedule_time in schedule_times:\n",
    "        candidate = datetime.combine(base_date, schedule_time, tzinfo=SCHEDULE_TIMEZONE)\n",
    "\n",
    "        if candidate > last_dt and candidate > now:\n",
    "            return candidate\n",
    "\n",
    "    next_date = base_date + timedelta(days=1)\n",
    "\n",
    "    return datetime.combine(\n",
    "        next_date,\n",
    "        schedule_times[0],\n",
    "        tzinfo=SCHEDULE_TIMEZONE,\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 6. JSON AND TEXT HELPERS\n",
    "# =============================================================================\n",
    "\n",
    "def extract_json(text):\n",
    "    text = str(text).strip()\n",
    "\n",
    "    text = re.sub(\n",
    "        r\"^```(?:json)?\\s*\",\n",
    "        \"\",\n",
    "        text,\n",
    "        flags=re.IGNORECASE\n",
    "    )\n",
    "\n",
    "    text = re.sub(r\"\\s*```$\", \"\", text)\n",
    "\n",
    "    start = text.find(\"{\")\n",
    "    end = text.rfind(\"}\")\n",
    "\n",
    "    if start < 0 or end <= start:\n",
    "        raise ValueError(\"AI did not return a JSON object\")\n",
    "\n",
    "    return json.loads(text[start:end + 1])\n",
    "\n",
    "\n",
    "def normalize_metadata(data):\n",
    "    required_fields = [\n",
    "        \"yt_title\",\n",
    "        \"yt_description\",\n",
    "        \"yt_tags\",\n",
    "        \"tiktok_caption\",\n",
    "        \"instagram_caption\",\n",
    "        \"fb_caption\",\n",
    "        \"popular_captions\",\n",
    "        \"hashtags\",\n",
    "        \"trending_event\",\n",
    "        \"keywords\",\n",
    "        \"snapchat_caption\"\n",
    "    ]\n",
    "\n",
    "    for field in required_fields:\n",
    "        data.setdefault(field, \"\")\n",
    "\n",
    "    for field in required_fields:\n",
    "        value = data[field]\n",
    "\n",
    "        if isinstance(value, list):\n",
    "            value = \", \".join(map(str, value))\n",
    "\n",
    "        data[field] = str(value).strip()[:49000]\n",
    "\n",
    "    return data\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 7. OPENROUTER GENERATION\n",
    "# =============================================================================\n",
    "\n",
    "def openrouter_generate(prompt):\n",
    "    if not OPENROUTER_API_KEY:\n",
    "        raise RuntimeError(\"OpenRouter API key is missing\")\n",
    "\n",
    "    last_exception = None\n",
    "    for model_candidate in OPENROUTER_MODELS:\n",
    "        try:\n",
    "            response = requests.post(\n",
    "                OPENROUTER_URL,\n",
    "                headers={\n",
    "                    \"Authorization\": f\"Bearer {OPENROUTER_API_KEY}\",\n",
    "                    \"Content-Type\": \"application/json\",\n",
    "                    \"HTTP-Referer\": \"https://github.com/\",\n",
    "                    \"X-Title\": \"Social Media Metadata Ranking Engine\"\n",
    "                },\n",
    "                json={\n",
    "                    \"model\": model_candidate,\n",
    "                    \"messages\": [\n",
    "                        {\n",
    "                            \"role\": \"system\",\n",
    "                            \"content\": (\n",
    "                                \"You are an expert social-media metadata \"\n",
    "                                \"writer. Return valid JSON only. \"\n",
    "                                \"Do not fabricate facts or current trends.\"\n",
    "                            )\n",
    "                        },\n",
    "                        {\n",
    "                            \"role\": \"user\",\n",
    "                            \"content\": prompt\n",
    "                        }\n",
    "                    ],\n",
    "                    \"temperature\": 0.7,\n",
    "                    \"max_tokens\": 1800,\n",
    "                    \"stream\": False\n",
    "                },\n",
    "                timeout=60\n",
    "            )\n",
    "\n",
    "            if response.ok:\n",
    "                payload = response.json()\n",
    "                content = payload[\"choices\"][0][\"message\"][\"content\"]\n",
    "                actual_model = payload.get(\"model\", model_candidate)\n",
    "                return normalize_metadata(extract_json(content)), actual_model\n",
    "            else:\n",
    "                raise RuntimeError(f\"HTTP {response.status_code}: {response.text[:200]}\")\n",
    "        except Exception as exc:\n",
    "            last_exception = exc\n",
    "            print(f\"    OpenRouter model {model_candidate} failed: {exc}. Trying next fallback...\")\n",
    "            time.sleep(1.5)\n",
    "\n",
    "    raise last_exception or RuntimeError(\"All configured OpenRouter models failed.\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 8. GROQ GENERATION\n",
    "# =============================================================================\n",
    "\n",
    "def groq_generate(prompt):\n",
    "    if not groq_client:\n",
    "        raise RuntimeError(\"Groq API key or client is missing\")\n",
    "\n",
    "    last_exception = None\n",
    "    for model_candidate in GROQ_MODELS:\n",
    "        try:\n",
    "            response = groq_client.chat.completions.create(\n",
    "                model=model_candidate,\n",
    "                messages=[\n",
    "                    {\n",
    "                        \"role\": \"system\",\n",
    "                        \"content\": (\n",
    "                            \"You are an expert social-media metadata \"\n",
    "                            \"writer. Return valid JSON only. \"\n",
    "                            \"Do not fabricate facts or current trends.\"\n",
    "                        )\n",
    "                    },\n",
    "                    {\n",
    "                        \"role\": \"user\",\n",
    "                        \"content\": prompt\n",
    "                    }\n",
    "                ],\n",
    "                temperature=0.7,\n",
    "                max_tokens=1800,\n",
    "                response_format={\"type\": \"json_object\"}\n",
    "            )\n",
    "            content = response.choices[0].message.content\n",
    "            return normalize_metadata(extract_json(content)), model_candidate\n",
    "        except Exception as exc:\n",
    "            last_exception = exc\n",
    "            print(f\"    Groq model {model_candidate} failed: {exc}. Trying next fallback...\")\n",
    "            time.sleep(1.5)\n",
    "\n",
    "    raise last_exception or RuntimeError(\"All configured Groq models failed.\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 9. QUALITY SCORING ENGINE\n",
    "# =============================================================================\n",
    "\n",
    "def score_candidate(metadata, video_context):\n",
    "    \"\"\"\n",
    "    Local quality heuristic.\n",
    "    \"\"\"\n",
    "    score = 0.0\n",
    "\n",
    "    title = metadata.get(\"yt_title\", \"\")\n",
    "    description = metadata.get(\"yt_description\", \"\")\n",
    "    tags = metadata.get(\"yt_tags\", \"\")\n",
    "    hashtags = metadata.get(\"hashtags\", \"\")\n",
    "    keywords = metadata.get(\"keywords\", \"\")\n",
    "\n",
    "    # Title readability and useful length\n",
    "    if 30 <= len(title) <= 75:\n",
    "        score += 20\n",
    "    elif 15 <= len(title) <= 90:\n",
    "        score += 12\n",
    "    elif title:\n",
    "        score += 5\n",
    "\n",
    "    # Description usefulness\n",
    "    if len(description) >= 100:\n",
    "        score += 15\n",
    "    elif len(description) >= 40:\n",
    "        score += 10\n",
    "\n",
    "    # Tags and hashtags\n",
    "    if tags:\n",
    "        score += 10\n",
    "\n",
    "    hashtag_count = len(re.findall(r\"#\\w+\", hashtags))\n",
    "\n",
    "    if 3 <= hashtag_count <= 8:\n",
    "        score += 15\n",
    "    elif hashtag_count > 0:\n",
    "        score += 8\n",
    "\n",
    "    keyword_count = len([\n",
    "        item for item in re.split(r\"[,;\\n]\", keywords)\n",
    "        if item.strip()\n",
    "    ])\n",
    "\n",
    "    if 4 <= keyword_count <= 12:\n",
    "        score += 15\n",
    "    elif keyword_count > 0:\n",
    "        score += 8\n",
    "\n",
    "    # Topic relevance using word overlap\n",
    "    context_words = set(re.findall(r\"\\b[a-zA-Z0-9]{4,}\\b\", video_context.lower()))\n",
    "    metadata_text = \" \".join([title, description, tags, hashtags, keywords]).lower()\n",
    "    metadata_words = set(re.findall(r\"\\b[a-zA-Z0-9]{4,}\\b\", metadata_text))\n",
    "\n",
    "    if context_words:\n",
    "        overlap = len(context_words & metadata_words) / len(context_words)\n",
    "        score += min(20, overlap * 40)\n",
    "\n",
    "    if not title:\n",
    "        score -= 40\n",
    "\n",
    "    words = re.findall(r\"\\b[a-zA-Z]{4,}\\b\", (title + \" \" + description).lower())\n",
    "    if words:\n",
    "        repetition = 1 - len(set(words)) / len(words)\n",
    "        score -= min(15, repetition * 30)\n",
    "\n",
    "    return round(max(0, min(100, score)), 2)\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 10. STRATEGIES AND 4X ENGINE WITH HYBRID FALLBACKS\n",
    "# =============================================================================\n",
    "\n",
    "STRATEGIES = [\n",
    "    (\n",
    "        \"SEARCH_SEO\",\n",
    "        \"Focus on accurate search phrases, relevant keywords, clear wording, and discoverability.\"\n",
    "    ),\n",
    "    (\n",
    "        \"CURIOSITY_HOOK\",\n",
    "        \"Create a compelling truthful hook that encourages interest without misleading clickbait.\"\n",
    "    ),\n",
    "    (\n",
    "        \"RETENTION\",\n",
    "        \"Focus on the audience's reason to watch, emotional connection, clarity, and strong opening wording.\"\n",
    "    ),\n",
    "    (\n",
    "        \"PLATFORM_OPTIMIZATION\",\n",
    "        \"Focus on natural language, platform suitability, readability, and relevant hashtags.\"\n",
    "    )\n",
    "]\n",
    "\n",
    "\n",
    "def build_prompt(video_name, platform, strategy_name, instructions):\n",
    "    return f\"\"\"\n",
    "Generate metadata for this video.\n",
    "\n",
    "VIDEO FILE:\n",
    "{video_name}\n",
    "\n",
    "TARGET PLATFORM:\n",
    "{platform}\n",
    "\n",
    "AUDIENCE:\n",
    "India and United Kingdom, where relevant to the actual content.\n",
    "Use the language appropriate for the video.\n",
    "\n",
    "STRATEGY:\n",
    "{strategy_name}\n",
    "\n",
    "INSTRUCTIONS:\n",
    "{instructions}\n",
    "\n",
    "RULES:\n",
    "- Do not invent events, news, trends, facts, or people.\n",
    "- Do not claim a hashtag is trending without verified trend data.\n",
    "- Use accurate and relevant keywords.\n",
    "- Avoid keyword stuffing and repetitive hashtags.\n",
    "- Write naturally and professionally.\n",
    "- Use suitable emojis where appropriate.\n",
    "- Make platform-specific captions distinct.\n",
    "- If the content is unknown from the filename, do not pretend that you watched the video.\n",
    "- Trending Event should say \"No live trend data verified\" unless actual verified trend information was supplied.\n",
    "\n",
    "Return ONLY valid JSON with these exact keys:\n",
    "{{\n",
    "  \"yt_title\": \"YouTube title\",\n",
    "  \"yt_description\": \"YouTube description\",\n",
    "  \"yt_tags\": \"comma-separated tags\",\n",
    "  \"tiktok_caption\": \"TikTok caption\",\n",
    "  \"instagram_caption\": \"Instagram caption\",\n",
    "  \"fb_caption\": \"Facebook caption\",\n",
    "  \"popular_captions\": \"alternative caption ideas\",\n",
    "  \"hashtags\": \"#relevant #hashtags\",\n",
    "  \"trending_event\": \"verified event or no live trend data verified\",\n",
    "  \"keywords\": \"comma-separated keywords\",\n",
    "  \"snapchat_caption\": \"Snapchat caption\"\n",
    "}}\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "def generate_4x_ranked_metadata(video_name):\n",
    "    context = f\"Video filename: {video_name}\"\n",
    "\n",
    "    # 1. TRY OPENROUTER 4X PLAN FIRST\n",
    "    print(\"\\n  [Plan A] Running OpenRouter 4x candidates generation and ranking...\")\n",
    "    candidates = []\n",
    "    openrouter_failed = False\n",
    "    for number, (strategy, instructions) in enumerate(STRATEGIES, start=1):\n",
    "        print(f\"    OpenRouter candidate {number}/4: {strategy}\")\n",
    "        prompt = build_prompt(video_name, \"Multi-platform social media\", strategy, instructions)\n",
    "\n",
    "        candidate = None\n",
    "        for attempt in range(2):\n",
    "            try:\n",
    "                candidate, model_used = openrouter_generate(prompt)\n",
    "                candidate[\"strategy\"] = strategy\n",
    "                candidate[\"model_used\"] = model_used\n",
    "                candidate[\"score\"] = score_candidate(candidate, context)\n",
    "                break\n",
    "            except Exception as exc:\n",
    "                print(f\"      Attempt {attempt+1} failed: {exc}\")\n",
    "                time.sleep(1.5)\n",
    "\n",
    "        if candidate is None:\n",
    "            print(\"    OpenRouter 4x generation incomplete/failed. Switching to Groq 4x Fallback.\")\n",
    "            openrouter_failed = True\n",
    "            break\n",
    "        candidates.append(candidate)\n",
    "        time.sleep(0.5)\n",
    "\n",
    "    if not openrouter_failed and len(candidates) == 4:\n",
    "        # Successfully ranked with OpenRouter\n",
    "        candidates.sort(key=lambda item: item[\"score\"], reverse=True)\n",
    "        winner = candidates[0]\n",
    "        scores = \" | \".join(f'{item[\"strategy\"]}:{item[\"score\"]}' for item in candidates)\n",
    "        print(f\"    OpenRouter 4x Winner: {winner['strategy']} (Score: {winner['score']})\")\n",
    "        return {\n",
    "            \"status\": \"openrouter_4x_ranked\",\n",
    "            \"ranking_used\": True,\n",
    "            \"selected\": winner,\n",
    "            \"score\": winner[\"score\"],\n",
    "            \"candidate_scores\": scores,\n",
    "            \"model_used\": winner.get(\"model_used\", \"\"),\n",
    "            \"error\": \"\"\n",
    "        }\n",
    "\n",
    "    # 2. TRY GROQ 4X PLAN (IF OPENROUTER FAILS)\n",
    "    print(\"\\n  [Plan B] Running Groq Free API 4x candidates generation and ranking fallback...\")\n",
    "    candidates = []\n",
    "    groq_failed = False\n",
    "    for number, (strategy, instructions) in enumerate(STRATEGIES, start=1):\n",
    "        print(f\"    Groq candidate {number}/4: {strategy}\")\n",
    "        prompt = build_prompt(video_name, \"Multi-platform social media\", strategy, instructions)\n",
    "\n",
    "        candidate = None\n",
    "        for attempt in range(2):\n",
    "            try:\n",
    "                candidate, model_used = groq_generate(prompt)\n",
    "                candidate[\"strategy\"] = strategy\n",
    "                candidate[\"model_used\"] = model_used\n",
    "                candidate[\"score\"] = score_candidate(candidate, context)\n",
    "                break\n",
    "            except Exception as exc:\n",
    "                print(f\"      Groq Attempt {attempt+1} failed: {exc}\")\n",
    "                time.sleep(1.5)\n",
    "\n",
    "        if candidate is None:\n",
    "            print(\"    Groq 4x generation incomplete/failed.\")\n",
    "            groq_failed = True\n",
    "            break\n",
    "        candidates.append(candidate)\n",
    "        time.sleep(0.5)\n",
    "\n",
    "    if not groq_failed and len(candidates) == 4:\n",
    "        # Successfully ranked with Groq\n",
    "        candidates.sort(key=lambda item: item[\"score\"], reverse=True)\n",
    "        winner = candidates[0]\n",
    "        scores = \" | \".join(f'{item[\"strategy\"]}:{item[\"score\"]}' for item in candidates)\n",
    "        print(f\"    Groq 4x Winner: {winner['strategy']} (Score: {winner['score']})\")\n",
    "        return {\n",
    "            \"status\": \"groq_4x_ranked\",\n",
    "            \"ranking_used\": True,\n",
    "            \"selected\": winner,\n",
    "            \"score\": winner[\"score\"],\n",
    "            \"candidate_scores\": scores,\n",
    "            \"model_used\": winner.get(\"model_used\", \"\"),\n",
    "            \"error\": \"\"\n",
    "        }\n",
    "\n",
    "    # 3. BOTH 4X PLANS FAILED: GENERATE SHEET WITHOUT 4X RANKING\n",
    "    print(\"\\n  [Plan C] Both OpenRouter & Groq 4x plans failed. Running single last-resort single generation fallback...\")\n",
    "    fallback_prompt = build_prompt(\n",
    "        video_name,\n",
    "        \"Multi-platform social media\",\n",
    "        \"BALANCED_FALLBACK\",\n",
    "        \"Generate one single balanced, highly accurate metadata set immediately without multiple candidates.\"\n",
    "    )\n",
    "\n",
    "    # Try Groq for single fallback\n",
    "    try:\n",
    "        print(\"    Attempting single fallback generation via Groq...\")\n",
    "        fallback, model_used = groq_generate(fallback_prompt)\n",
    "        return {\n",
    "            \"status\": \"groq_single_fallback\",\n",
    "            \"ranking_used\": False,\n",
    "            \"selected\": fallback,\n",
    "            \"score\": \"\",\n",
    "            \"candidate_scores\": \"\",\n",
    "            \"model_used\": model_used,\n",
    "            \"error\": \"\"\n",
    "        }\n",
    "    except Exception as groq_exc:\n",
    "        print(f\"    Groq single fallback failed: {groq_exc}\")\n",
    "\n",
    "    # Try OpenRouter for single fallback\n",
    "    try:\n",
    "        print(\"    Attempting single fallback generation via OpenRouter...\")\n",
    "        fallback, model_used = openrouter_generate(fallback_prompt)\n",
    "        return {\n",
    "            \"status\": \"openrouter_single_fallback\",\n",
    "            \"ranking_used\": False,\n",
    "            \"selected\": fallback,\n",
    "            \"score\": \"\",\n",
    "            \"candidate_scores\": \"\",\n",
    "            \"model_used\": model_used,\n",
    "            \"error\": \"\"\n",
    "        }\n",
    "    except Exception as or_exc:\n",
    "        print(f\"    OpenRouter single fallback failed: {or_exc}\")\n",
    "\n",
    "    return {\n",
    "        \"status\": \"failed\",\n",
    "        \"ranking_used\": False,\n",
    "        \"selected\": {},\n",
    "        \"score\": \"\",\n",
    "        \"candidate_scores\": \"\",\n",
    "        \"model_used\": \"\",\n",
    "        \"error\": \"All OpenRouter and Groq fallbacks failed completely.\"\n",
    "    }\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 11. LOCAL THUMBNAIL CREATION\n",
    "# =============================================================================\n",
    "\n",
    "def create_thumbnail(video_path, video_name):\n",
    "    thumbnail_path = LOCAL_THUMBNAIL_DIR / f\"{Path(video_name).stem}_thumb.jpg\"\n",
    "    try:\n",
    "        duration_text = subprocess.check_output(\n",
    "            [\"ffprobe\", \"-v\", \"error\", \"-show_entries\", \"format=duration\",\n",
    "             \"-of\", \"default=noprint_wrappers=1:nokey=1\", video_path],\n",
    "            text=True,\n",
    "        ).strip()\n",
    "        duration = float(duration_text)\n",
    "        timestamp = min(1.0, max(0.0, duration / 2.0))\n",
    "        subprocess.run(\n",
    "            [\"ffmpeg\", \"-y\", \"-ss\", str(timestamp), \"-i\", video_path,\n",
    "             \"-frames:v\", \"1\", \"-q:v\", \"2\", str(thumbnail_path)],\n",
    "            check=True, capture_output=True, text=True,\n",
    "        )\n",
    "        if not thumbnail_path.is_file() or thumbnail_path.stat().st_size == 0:\n",
    "            raise RuntimeError(\"FFmpeg did not create a thumbnail image.\")\n",
    "        return str(thumbnail_path.relative_to(WORKSPACE_ROOT))\n",
    "    except Exception as exc:\n",
    "        print(\"  Thumbnail warning:\", exc)\n",
    "        return \"N/A\"\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 12. MAIN PROCESS\n",
    "# =============================================================================\n",
    "\n",
    "print(\"\\nStarting Advanced Hybrid Metadata Engine...\")\n",
    "print(\"Source:\", SOURCE_FOLDER_PATH)\n",
    "print(\"Reports and thumbnails are saved locally:\", LOCAL_OUTPUT_DIR)\n",
    "\n",
    "if not any(\n",
    "    name.lower().endswith((\".mp4\", \".mov\", \".avi\", \".mkv\"))\n",
    "    for _, _, filenames in os.walk(SOURCE_FOLDER_PATH)\n",
    "    for name in filenames\n",
    "):\n",
    "    raise RuntimeError(\n",
    "        f\"No supported videos were found in {SOURCE_FOLDER_PATH}. \"\n",
    "        \"Confirm Part 3 created local videos under Ready_!.\"\n",
    "    )\n",
    "\n",
    "processed_count = 0\n",
    "skipped_count = 0\n",
    "failed_count = 0\n",
    "local_rows = []\n",
    "report_links = []  # kept empty for backward-compatible summary structure\n",
    "\n",
    "for root, dirs, files in os.walk(SOURCE_FOLDER_PATH):\n",
    "\n",
    "    # Avoid scanning thumbnail folder\n",
    "    dirs[:] = [\n",
    "        folder for folder in dirs\n",
    "        if folder != THUMBNAIL_FOLDER_NAME\n",
    "    ]\n",
    "\n",
    "    videos = sorted([\n",
    "        name for name in files\n",
    "        if name.lower().endswith((\".mp4\", \".mov\", \".avi\", \".mkv\"))\n",
    "    ])\n",
    "\n",
    "    if not videos:\n",
    "        continue\n",
    "\n",
    "    folder_name = os.path.basename(root)\n",
    "\n",
    "    print(\"\\nLocal report folder:\", folder_name)\n",
    "    print(\"Folder:\", root)\n",
    "\n",
    "    existing_names = set()\n",
    "    last_dt = get_last_post_time()\n",
    "    rows_to_save = []\n",
    "\n",
    "    for video_name in videos:\n",
    "\n",
    "        if video_name in existing_names:\n",
    "            print(\"  Skipping existing video:\", video_name)\n",
    "            skipped_count += 1\n",
    "            continue\n",
    "\n",
    "        video_path = os.path.join(root, video_name)\n",
    "\n",
    "        next_dt = get_next_schedule_slot(last_dt)\n",
    "        formatted_time = next_dt.strftime(\n",
    "            \"%Y-%m-%d %I:%M %p\"\n",
    "        )\n",
    "        last_dt = next_dt\n",
    "\n",
    "        print(\"\\nProcessing:\", video_name)\n",
    "        print(\"Scheduled time:\", formatted_time)\n",
    "\n",
    "        # Local workspace only: there is no remote video URL.\n",
    "        video_url = \"LOCAL_WORKSPACE_ONLY\"\n",
    "\n",
    "        # Try multi-level candidates framework (OR 4X -> Groq 4X -> Single Fallback)\n",
    "        try:\n",
    "            result = generate_4x_ranked_metadata(video_name)\n",
    "\n",
    "            if result[\"status\"] == \"failed\":\n",
    "                raise RuntimeError(result.get(\"error\", \"Generation failed completely.\"))\n",
    "\n",
    "            metadata = result[\"selected\"]\n",
    "\n",
    "        except Exception as exc:\n",
    "            print(\"  Metadata generation failed completely:\", exc)\n",
    "            failed_count += 1\n",
    "            continue\n",
    "\n",
    "        thumbnail_url = create_thumbnail(\n",
    "            video_path,\n",
    "            video_name\n",
    "        )\n",
    "\n",
    "        generated_at = datetime.now().strftime(\n",
    "            \"%Y-%m-%d %H:%M:%S\"\n",
    "        )\n",
    "\n",
    "        row = [\n",
    "            video_name,\n",
    "            video_path,\n",
    "            \"pending\",\n",
    "            formatted_time,\n",
    "            video_url,\n",
    "            thumbnail_url,\n",
    "            metadata.get(\"yt_title\", \"\"),\n",
    "            metadata.get(\"yt_description\", \"\"),\n",
    "            metadata.get(\"yt_tags\", \"\"),\n",
    "            metadata.get(\"tiktok_caption\", \"\"),\n",
    "            metadata.get(\"instagram_caption\", \"\"),\n",
    "            metadata.get(\"fb_caption\", \"\"),\n",
    "            metadata.get(\"popular_captions\", \"\"),\n",
    "            metadata.get(\"hashtags\", \"\"),\n",
    "            metadata.get(\"trending_event\", \"\"),\n",
    "            metadata.get(\"keywords\", \"\"),\n",
    "            metadata.get(\"snapchat_caption\", \"\"),\n",
    "            result.get(\"model_used\", \"\"),\n",
    "            str(result.get(\"ranking_used\", False)),\n",
    "            str(result.get(\"score\", \"\")),\n",
    "            result.get(\"candidate_scores\", \"\"),\n",
    "            generated_at\n",
    "        ]\n",
    "\n",
    "        rows_to_save.append(row)\n",
    "        local_rows.append(row)\n",
    "        existing_names.add(video_name)\n",
    "        processed_count += 1\n",
    "\n",
    "        print(\"  AI status:\", result[\"status\"])\n",
    "        print(\"  Ranking used:\", result[\"ranking_used\"])\n",
    "\n",
    "    if rows_to_save:\n",
    "        print(f\"Prepared {len(rows_to_save)} local metadata rows for {folder_name}\")\n",
    "\n",
    "\n",
    "# Save a local copy of newly generated rows and a run summary.\n",
    "csv_path = LOCAL_OUTPUT_DIR / \"metadata_rows.csv\"\n",
    "with csv_path.open(\"w\", newline=\"\", encoding=\"utf-8-sig\") as csv_file:\n",
    "    writer = csv.writer(csv_file)\n",
    "    writer.writerow(SHEET_HEADER)\n",
    "    writer.writerows(local_rows)\n",
    "\n",
    "summary = {\n",
    "    \"processed_count\": processed_count,\n",
    "    \"skipped_count\": skipped_count,\n",
    "    \"failed_count\": failed_count,\n",
    "    \"source_folder\": SOURCE_FOLDER_PATH,\n",
    "    \"schedule_timezone\": str(SCHEDULE_TIMEZONE),\n",
    "    \"cloud_storage\": False,\n",
    "    \"google_sheets_reports\": [],\n",
    "    \"local_thumbnail_directory\": str(LOCAL_THUMBNAIL_DIR),\n",
    "    \"generated_at\": datetime.now(SCHEDULE_TIMEZONE).isoformat(),\n",
    "}\n",
    "summary_path = LOCAL_OUTPUT_DIR / \"run_summary.json\"\n",
    "summary_path.write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 65)\n",
    "print(\"PROCESS COMPLETED\")\n",
    "print(\"=\" * 65)\n",
    "print(\"Successfully processed:\", processed_count)\n",
    "print(\"Skipped existing videos:\", skipped_count)\n",
    "print(\"Failed videos:\", failed_count)\n",
    "print(\"Local CSV report:\", csv_path)\n",
    "print(\"Local run summary:\", summary_path)\n",
    "print(\"Cloud uploads: disabled (local workspace only)\")\n",
    "print(\"Local thumbnails:\", LOCAL_THUMBNAIL_DIR)\n",
    "\n",
    "if processed_count == 0 and failed_count > 0:\n",
    "    raise RuntimeError(\"All new video metadata generation attempts failed. Check API quotas and keys.\")"
   ]
